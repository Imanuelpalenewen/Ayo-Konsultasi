# ─── Convex ────────────────────────────────────────────────────────────────────
# Get these by running: npx convex dev  (development) or npx convex deploy (production)
CONVEX_DEPLOYMENT=
VITE_CONVEX_URL=

# ─── Google Gemini ─────────────────────────────────────────────────────────────
# Development only — in production, set GEMINI_API_KEY in the Convex Dashboard instead
VITE_GEMINI_API_KEY=

# ─── Convex Dashboard Environment Variables ────────────────────────────────────
# These are set in https://dashboard.convex.dev → your project → Settings → Environment Variables
# DO NOT put these in .env.local — they are server-side only
#
# GEMINI_API_KEY=          # Google Gemini API key (server-side, for Convex Actions)
# GEMINI_MODEL=gemini-2.0-flash   # or gemini-2.5-flash for demo/presentation
# AI_PROVIDER=gemini       # "gemini" | "mistral" — swap without changing code
# MISTRAL_API_KEY=         # Optional: Mistral fallback (get from console.mistral.ai)
# JWT_PRIVATE_KEY=         # Generated via: node generateKeys.mjs
# JWKS=                    # Generated via: node generateKeys.mjs
# SITE_URL=                # Your production URL, e.g. https://ayokonsultasi.vercel.app
